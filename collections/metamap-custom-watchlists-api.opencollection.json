{
  "opencollection": "1.0.0",
  "info": {
    "name": "MetaMap Authentication Custom Watchlists API",
    "version": "1.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Custom Watchlists",
        "type": "folder"
      },
      "items": [
